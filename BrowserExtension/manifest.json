{
  "manifest_version": 3,
  "name": "AutoDisplay · 全屏视频",
  "version": "0.1.0",
  "description": "全屏视频时通知本机 AutoDisplay 调亮显示器，退出后恢复日常亮度。",
  "permissions": [
    "storage"
  ],
  "host_permissions": [
    "http://127.0.0.1:48741/*"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": [
        "http://*/*",
        "https://*/*"
      ],
      "js": [
        "content.js"
      ],
      "all_frames": true,
      "match_about_blank": true,
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_title": "AutoDisplay：连接菜单栏工具",
    "default_popup": "popup.html"
  },
  "key": ""
}
